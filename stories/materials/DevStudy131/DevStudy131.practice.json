      {
        "id": "SH.2",
        "speakerId": "kim",
        "displayText": "My goal is to explain one feature clearly.",
        "translation": "Meu objetivo é explicar uma funcionalidade com clareza."
      },
      {
        "id": "SH.3",
        "speakerId": "owen",
        "displayText": "I expected the tasks to stay in the list.",
        "translation": "Eu esperava que as tarefas continuassem na lista."
      },
      {
        "id": "SH.4",
        "speakerId": "niamh",
        "displayText": "After I refreshed the page, the list was empty.",
        "translation": "Depois que eu atualizei a página, a lista estava vazia."
      },
      {
        "id": "SH.5",
        "speakerId": "kim",
        "displayText": "Could you say that again?",
        "translation": "Você poderia repetir?"
      },
      {
        "id": "SH.6",
        "speakerId": "kim",
        "displayText": "Next time, I’ll test one small change.",
        "translation": "Da próxima vez, vou testar uma pequena mudança."
      }
    ]
