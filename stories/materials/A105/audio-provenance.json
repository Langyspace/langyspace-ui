    {
      "id": "D.1",
      "text": "This market is great! Do you like mangoes?",
      "speaker": "kim",
      "voiceId": "Nhs7eitvQWFTQBsf0yiT",
      "voiceName": "Sarah Explains",
      "provider": "elevenlabs",
      "modelId": "eleven_multilingual_v2",
      "durationSeconds": 3.529433,
      "sha256": "390fd5034bffc3947d915d20334f1025f13f402849921a0378f95186abfce65c",
      "file": "assets/audio/D.1.mp3"
    },
    {
      "id": "D.2",
      "text": "Yes, I do. I love mangoes. What about you?",
      "speaker": "ana",
      "voiceId": "cgSgspJ2msm6clMCkdW9",
      "voiceName": "Jessica - Playful, Bright, Warm",
      "provider": "elevenlabs",
      "modelId": "eleven_multilingual_v2",
      "durationSeconds": 2.925714,
      "sha256": "42797f3e6a9cc765c4687547eb53a5bfbb979e539a40b4e4fe970f210428c8bc",
      "file": "assets/audio/D.2.mp3"
    },
    {
      "id": "D.3",
      "text": "I like mangoes, but I don’t like watermelons.",
      "speaker": "kim",
      "voiceId": "Nhs7eitvQWFTQBsf0yiT",
      "voiceName": "Sarah Explains",
      "provider": "elevenlabs",
      "modelId": "eleven_multilingual_v2",
      "durationSeconds": 3.575873,
      "sha256": "5c82d6c6eff57430aac1faced6f2d49eec98292218d1630457e48ae318a55179",
      "file": "assets/audio/D.3.mp3"
    },
    {
      "id": "D.4",
      "text": "My mother loves watermelons! Do you like carrots?",
      "speaker": "ana",
      "voiceId": "cgSgspJ2msm6clMCkdW9",
      "voiceName": "Jessica - Playful, Bright, Warm",
      "provider": "elevenlabs",
      "modelId": "eleven_multilingual_v2",
      "durationSeconds": 3.297234,
      "sha256": "7b2b800ef389b33ce493263e0671d1767b6044180e5c0c9ccc0c2d16b10fb9b8",
      "file": "assets/audio/D.4.mp3"
    },
    {
      "id": "D.5",
      "text": "Yes, I do. How much are they?",
      "speaker": "kim",
      "voiceId": "Nhs7eitvQWFTQBsf0yiT",
      "voiceName": "Sarah Explains",
      "provider": "elevenlabs",
      "modelId": "eleven_multilingual_v2",
      "durationSeconds": 2.647075,
      "sha256": "730bac6bb7357ab7578f6a3cca8b6d40911006f6249cb592237b237fadf2763a",
      "file": "assets/audio/D.5.mp3"
    },
    {
      "id": "D.6",
      "text": "They’re two reais.",
      "speaker": "ana",
      "voiceId": "cgSgspJ2msm6clMCkdW9",
      "voiceName": "Jessica - Playful, Bright, Warm",
      "provider": "elevenlabs",
      "modelId": "eleven_multilingual_v2",
      "durationSeconds": 1.300317,
      "sha256": "91572ea414485b2dbba6f839736343bd032e73f84cb3a211582e10e2ade2906b",
      "file": "assets/audio/D.6.mp3"
    },
    {
      "id": "G.1",
      "text": "Do you like apples?",
      "speaker": "kim",
      "voiceId": "Nhs7eitvQWFTQBsf0yiT",
      "voiceName": "Sarah Explains",
      "provider": "elevenlabs",
      "modelId": "eleven_multilingual_v2",
      "durationSeconds": 1.671837,
      "sha256": "0cd4b013d0fef63abc934015f7e7b1d4a1e02bd51d0efadf538afab163761111",
      "file": "assets/audio/G.1.mp3"
    },
    {
      "id": "G.2",
      "text": "Yes, I do. I love apples.",
      "speaker": "ana",
      "voiceId": "cgSgspJ2msm6clMCkdW9",
      "voiceName": "Jessica - Playful, Bright, Warm",
      "provider": "elevenlabs",
      "modelId": "eleven_multilingual_v2",
      "durationSeconds": 1.811156,
      "sha256": "fc41c342dbfa70a66c6bcfae17b1e206b2fe9dd3c48bc8c8d6a1ab1a49352dc2",
      "file": "assets/audio/G.2.mp3"
    },
    {
      "id": "G.3",
      "text": "My sister likes bananas. What about you?",
      "speaker": "kim",
      "voiceId": "Nhs7eitvQWFTQBsf0yiT",
      "voiceName": "Sarah Explains",
      "provider": "elevenlabs",
      "modelId": "eleven_multilingual_v2",
      "durationSeconds": 3.204354,
      "sha256": "e79a374ec0ba1b9400b3ae5d53f568ba71836ba8b9d68c9509e61839d5ed4de4",
      "file": "assets/audio/G.3.mp3"
    },
    {
      "id": "G.4",
      "text": "I like bananas, but I don’t like onions.",
      "speaker": "ana",
      "voiceId": "cgSgspJ2msm6clMCkdW9",
      "voiceName": "Jessica - Playful, Bright, Warm",
      "provider": "elevenlabs",
      "modelId": "eleven_multilingual_v2",
      "durationSeconds": 2.368435,
      "sha256": "174dedcca20fedf8cfa3cd69fad806f5d38ad78d67d510de6575689eaffe47cf",
      "file": "assets/audio/G.4.mp3"
    },
    {
      "id": "L.1",
      "text": "Hi! See you on Saturday at the market. I need some fruit. I like bananas and green apples, but I don’t like oranges. My sister Jin loves mangoes. What fruit do you like?",
      "speaker": "kim",
      "voiceId": "Nhs7eitvQWFTQBsf0yiT",
      "voiceName": "Sarah Explains",
      "provider": "elevenlabs",
      "modelId": "eleven_multilingual_v2",
      "durationSeconds": 13.560454,
      "sha256": "a31fa62081477ffb915aa36b3521735425217638f0c7d988dbb076ca5c5686fa",
      "file": "assets/audio/L.1.mp3"
    }
