        {
          "id": "D.1",
          "speaker": "Kim",
          "text": "What time do you get up?",
          "translation": "A que horas você levanta?"
        },
        {
          "id": "D.2",
          "speaker": "Ana",
          "text": "I always get up early, at six. I work in the morning.",
          "translation": "Eu sempre levanto cedo, às seis. Eu trabalho de manhã."
        },
        {
          "id": "D.3",
          "speaker": "Kim",
          "text": "And in the evening?",
          "translation": "E à noite?"
        },
        {
          "id": "D.4",
          "speaker": "Ana",
          "text": "I study on Monday and Wednesday, after work.",
          "translation": "Eu estudo na segunda e na quarta, depois do trabalho."
        },
        {
          "id": "D.5",
          "speaker": "Kim",
          "text": "I go to the gym on Tuesday at seven in the evening. Are you free?",
          "translation": "Eu vou à academia na terça às sete da noite. Você está livre?"
        },
        {
          "id": "D.6",
          "speaker": "Ana",
          "text": "Yes, I am. Great! See you on Tuesday.",
          "translation": "Sim, estou. Ótimo! Até terça."
        }
      ]
