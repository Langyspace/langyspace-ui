      "sourceFileSha256AtFreeze": "27ebd643e624004e5ceeeb4124108e2cde02b9751136f4e3f305514e5845e5bc",
      "arrayField": "expressions",
      "sourceArraySha256": "d761536d0fa862e89bbea803338d2769a1c4d359f4f29fdc4f89bca20b25f5c1",
      "sourceArray": [
        {
          "s": "Short emails can {come across as} cold.",
          "e": "come across as",
          "m": "seem to other people",
          "t": "passar a impressão de, soar como",
          "i": 0
        },
        {
          "s": "Ten slides in two minutes? The end was {a bit rushed}.",
          "e": "a bit rushed",
          "m": "a little too fast",
          "t": "um pouco corrido, apressado",
          "i": 1
        },
        {
          "s": "The food was cold. {To be fair}, the restaurant was very busy.",
          "e": "To be fair",
          "m": "let’s be honest about the other side too",
          "t": "para ser justa, verdade seja dita",
          "i": 2
        },
        {
          "s": "Ana is a team leader now. There’s {a learning curve}.",
          "e": "a learning curve",
          "m": "time to learn something new",
          "t": "uma fase de aprendizado",
          "i": 3
        },
        {
          "s": "Raj listened to the feedback and said: “I’ll {take it on board}.”",
          "e": "take it on board",
          "m": "I’ll think about it and use it",
          "t": "vou levar isso em conta",
          "i": 4
        },
        {
          "s": "{It’s worth practicing} before a big meeting.",
          "e": "It’s worth practicing",
          "m": "it’s a good idea; it helps",
          "t": "vale a pena praticar",
          "i": 5
        },
        {
          "s": "Good feedback is {constructive}: it says what to do next.",
          "e": "constructive",
          "m": "it helps you get better",
          "t": "construtivo",
          "i": 6
        },
        {
          "s": "“Your slides were bad.” That sounds {harsh}.",
          "e": "harsh",
          "m": "too hard, not kind",
          "t": "duro, ríspido",
          "i": 7
        }
      ],
      "count": 8
    }
  ],
