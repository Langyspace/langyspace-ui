      "disposition": "preserved_exact_bytes"
    },
    {
      "id": "D.9",
      "text": "Oh no. And then?",
      "voiceId": "Nhs7eitvQWFTQBsf0yiT",
      "durationSeconds": 1.904036,
      "provider": "elevenlabs",
      "requestId": null,
      "sourceRecord": "stories/materials/shared/conversationRecordings.ts",
