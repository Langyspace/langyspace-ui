      "sha256": "93a15011e0cf2561e2a3f0b8848d71a8a02811845bcfa5f7e0262ba46e5a850a",
      "disposition": "preserved_exact_bytes"
    },
    {
      "id": "D.2",
      "text": "Pretty good, but on the second day, my phone died at four in the afternoon.",
      "voiceId": "cgSgspJ2msm6clMCkdW9",
      "durationSeconds": 4.411791,
      "provider": "elevenlabs",
      "requestId": null,
      "sourceRecord": "stories/materials/shared/conversationRecordings.ts",
      "lesson": "B2.01",
      "file": "assets/audio/legacy-B201-D.2.mp3",
      "sourceFile": "/Users/margaridamartins/Documents/Codex/langy-course-implementation79-20261123/stories/materials/B201/assets/dialogue/02.mp3",
      "sourceId": "D.2",
      "sha256": "737019063aae3148debd1e0a129b5a62b7cd83df100254568fed82120ec1e932",
      "disposition": "preserved_exact_bytes"
    },
    {
      "id": "D.3",
      "text": "Oh no! Why?",
      "voiceId": "Nhs7eitvQWFTQBsf0yiT",
      "durationSeconds": 1.625397,
      "provider": "elevenlabs",
      "requestId": null,
      "sourceRecord": "stories/materials/shared/conversationRecordings.ts",
      "lesson": "B2.01",
      "file": "assets/audio/legacy-B201-D.3.mp3",
      "sourceFile": "/Users/margaridamartins/Documents/Codex/langy-course-implementation79-20261123/stories/materials/B201/assets/dialogue/03.mp3",
      "sourceId": "D.3",
      "sha256": "6b678eff73cd89f0306664024e56ca783c1fbe212897bc459bb74034be0456b0",
      "disposition": "preserved_exact_bytes"
    },
    {
      "id": "D.4",
      "text": "I’d been using it as a map all day, and I didn’t notice how low the battery was. And I’d left my charger at the hotel.",
      "voiceId": "cgSgspJ2msm6clMCkdW9",
      "durationSeconds": 7.383946,
      "provider": "elevenlabs",
      "requestId": null,
      "sourceRecord": "stories/materials/shared/conversationRecordings.ts",
      "lesson": "B2.01",
      "file": "assets/audio/legacy-B201-D.4.mp3",
      "sourceFile": "/Users/margaridamartins/Documents/Codex/langy-course-implementation79-20261123/stories/materials/B201/assets/dialogue/04.mp3",
