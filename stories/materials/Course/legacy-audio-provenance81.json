      "id": "D.7",
      "text": "So what did you do?",
      "voiceId": "Nhs7eitvQWFTQBsf0yiT",
      "durationSeconds": 1.346757,
      "provider": "elevenlabs",
      "requestId": null,
      "sourceRecord": "stories/materials/shared/conversationRecordings.ts",
      "lesson": "B2.01",
      "file": "assets/audio/legacy-B201-D.7.mp3",
      "sourceFile": "/Users/margaridamartins/Documents/Codex/langy-course-implementation79-20261123/stories/materials/B201/assets/dialogue/07.mp3",
      "sourceId": "D.7",
      "sha256": "a1357fcacb5613c2d9b389232574553c504d545516daef07c5c8327387496309",
      "disposition": "preserved_exact_bytes"
    },
    {
      "id": "D.8",
      "text": "I asked a doorman for help, and he told me about a café. But there were no free outlets.",
      "voiceId": "cgSgspJ2msm6clMCkdW9",
      "durationSeconds": 5.24771,
      "provider": "elevenlabs",
      "requestId": null,
      "sourceRecord": "stories/materials/shared/conversationRecordings.ts",
      "lesson": "B2.01",
      "file": "assets/audio/legacy-B201-D.8.mp3",
