      "sha256": "f2120086fd0976cd446c389d5a9c58f3bcf38b096fcdc132773797b639830934",
      "disposition": "preserved_exact_bytes"
    },
    {
      "id": "D.5",
      "text": "Why didn’t you go back to the hotel?",
      "voiceId": "Nhs7eitvQWFTQBsf0yiT",
      "durationSeconds": 2.229116,
      "provider": "elevenlabs",
      "requestId": null,
      "sourceRecord": "stories/materials/shared/conversationRecordings.ts",
      "lesson": "B2.01",
      "file": "assets/audio/legacy-B201-D.5.mp3",
      "sourceFile": "/Users/margaridamartins/Documents/Codex/langy-course-implementation79-20261123/stories/materials/B201/assets/dialogue/05.mp3",
      "sourceId": "D.5",
      "sha256": "01f0e08b9b3061eb44cf6978187337003eb3f0febaecd92866fb4b4f286f86e8",
      "disposition": "preserved_exact_bytes"
    },
    {
      "id": "D.6",
      "text": "I tried, but I got lost. And the team dinner was at seven. The address was in a message from Raj!",
      "voiceId": "cgSgspJ2msm6clMCkdW9",
      "durationSeconds": 6.965986,
      "provider": "elevenlabs",
      "requestId": null,
      "sourceRecord": "stories/materials/shared/conversationRecordings.ts",
      "lesson": "B2.01",
      "file": "assets/audio/legacy-B201-D.6.mp3",
      "sourceFile": "/Users/margaridamartins/Documents/Codex/langy-course-implementation79-20261123/stories/materials/B201/assets/dialogue/06.mp3",
