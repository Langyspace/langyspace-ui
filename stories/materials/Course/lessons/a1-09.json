    {
      "id": "s_grammar",
      "kind": "grammar",
      "eyebrow": "Grammar",
      "title": "Use there is and there are",
      "instruction": "Use there to say that a place or thing exists, then choose singular or plural",
      "minutes": 3,
      "layout": "patterns",
      "columns": {
        "subject": "Meaning",
        "verb": "Form",
        "example": "Pattern and examples"
      },
      "rows": [
        {
          "id": "0",
          "subject": "One place or thing",
          "verb": "There is / There isn’t + a / an + noun",
          "example": "There is a café. There isn’t a bank near the hotel"
        },
        {
          "id": "1",
          "subject": "Two or more",
          "verb": "There are / There aren’t + plural noun",
          "example": "There are two shops. There aren’t any shops on this street"
        },
        {
          "id": "2",
          "subject": "Ask whether something exists",
          "verb": "Is there a …? / Are there any …?",
          "example": "Is there a pharmacy? Are there any cafés?"
        }
      ],
      "note": "There is → There’s. Short answers: Yes, there is / No, there isn’t; Yes, there are / No, there aren’t."
    },
    {
      "id": "s_mission",
      "kind": "activity",
      "title": "Give directions",
      "instruction": "Meet me at the café. Tell me how to get from the hotel to the café",
      "minutes": 5,
      "eyebrow": "Speaking task"
    },
    {
      "id": "s_listening",
      "kind": "listening",
      "title": "Listen and answer",
      "instruction": "Meet me in the park. Listen for the new information and decide how to respond",
      "minutes": 5,
      "eyebrow": "Listening",
      "message": "Hi, Ana! Let’s meet at the park, not the café. Start at the hotel and go straight. Turn right at the second street. The park is at the end, after the market. I’m near the trees. See you in ten minutes!",
      "audioText": "Hi, Ana! Let’s meet at the park, not the café. Start at the hotel and go straight. Turn right at the second street. The park is at the end, after the market. I’m near the trees. See you in ten minutes!",
      "audioId": "A109-L81.1",
      "greeting": "Here’s the area near our meeting point",
      "items": [
        {
          "id": "listen",
          "prompt": "Where should Ana meet Kim?",
          "hint": "They should meet at …",
          "answer": "Ana should meet Kim at the park"
        },
        {
          "id": "s_listening.q98.2",
          "prompt": "Which street should Ana turn right at?",
          "hint": "She should turn at the … street",
          "answer": "Ana should turn right at the second street"
        },
        {
          "id": "s_listening.q98.3",
          "prompt": "Where is Kim waiting?",
          "hint": "She’s near …",
          "answer": "Kim is waiting near the trees"
        }
      ],
      "greetingTimestamp": "10:00",
      "voiceTimestamp": "10:01",
      "contact": {
        "name": "Kim"
      },
      "image": {
