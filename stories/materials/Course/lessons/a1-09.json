      "lines": [
        {
          "id": "A109-D81.1",
          "speaker": "Kim",
          "text": "Excuse me. Is there a café near the hotel?",
          "audioText": "Excuse me. Is there a café near the hotel?",
          "translation": "Com licença. Tem um café perto do hotel?"
        },
        {
          "id": "A109-D81.2",
          "speaker": "Ana",
          "text": "Yes, there is. Go straight and turn right at the first street",
          "audioText": "Yes, there is. Go straight and turn right at the first street.",
          "translation": "Sim. Siga em frente e vire à direita na primeira rua"
        },
        {
          "id": "A109-D81.3",
          "speaker": "Kim",
          "text": "Is it next to the pharmacy?",
          "audioText": "Is it next to the pharmacy?",
          "translation": "Fica ao lado da farmácia?"
        },
        {
          "id": "A109-D81.4",
          "speaker": "Ana",
          "text": "Yes. The pharmacy is on the same street",
          "audioText": "Yes. The pharmacy is on the same street.",
          "translation": "Sim. A farmácia fica na mesma rua"
        },
        {
          "id": "A109-D81.5",
          "speaker": "Kim",
          "text": "Great. And is there a park here?",
          "audioText": "Great. And is there a park here?",
          "translation": "Ótimo. E tem um parque aqui?"
        },
        {
          "id": "A109-D81.6",
          "speaker": "Ana",
          "text": "Yes. Go straight and take the second right. The park is at the end",
          "audioText": "Yes. Go straight and take the second right. The park is at the end.",
          "translation": "Sim. Siga em frente e pegue a segunda à direita. O parque fica no final"
        }
      ],
