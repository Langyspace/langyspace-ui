    {
      "id": "s_dialogue1",
      "kind": "dialogue",
      "title": "Practise the conversation",
      "instruction": "You are Ana and Teacher is Kim. Practise together, swap roles, then answer the questions",
      "minutes": 6,
      "eyebrow": "Guided conversation",
      "lines": [
        {
          "id": "A109-D81.1",
          "speaker": "Kim",
          "text": "Excuse me. Is there a café near the hotel?",
          "audioText": "Excuse me. Is there a café near the hotel?",
          "translation": "Com licença. Tem um café perto do hotel?"
        },
        {
          "id": "A109-D81.2",
          "speaker": "Ana",
          "text": "Yes, there is. Go straight and turn right at the first street",
          "audioText": "Yes, there is. Go straight and turn right at the first street.",
          "translation": "Sim. Siga em frente e vire à direita na primeira rua"
        },
        {
          "id": "A109-D81.3",
          "speaker": "Kim",
          "text": "Is it next to the pharmacy?",
          "audioText": "Is it next to the pharmacy?",
          "translation": "Fica ao lado da farmácia?"
        },
        {
          "id": "A109-D81.4",
          "speaker": "Ana",
          "text": "Yes. The pharmacy is on the same street",
          "audioText": "Yes. The pharmacy is on the same street.",
          "translation": "Sim. A farmácia fica na mesma rua"
        },
        {
          "id": "A109-D81.5",
          "speaker": "Kim",
          "text": "Great. And is there a park here?",
          "audioText": "Great. And is there a park here?",
          "translation": "Ótimo. E tem um parque aqui?"
        },
        {
          "id": "A109-D81.6",
          "speaker": "Ana",
          "text": "Yes. Go straight and take the second right. The park is at the end",
          "audioText": "Yes. Go straight and take the second right. The park is at the end.",
          "translation": "Sim. Siga em frente e pegue a segunda à direita. O parque fica no final"
        }
      ],
      "questions": [
        {
          "id": "d0",
          "prompt": "Which street takes Kim to the café?",
          "hint": "She should take the … street",
          "answer": "Kim should turn right at the first street"
        },
        {
          "id": "s_dialogue1.q98.2",
          "prompt": "Is the café next to the pharmacy?",
          "hint": "Yes, it …",
          "answer": "Yes, the café is next to the pharmacy"
        },
        {
          "id": "s_dialogue1.q98.3",
          "prompt": "How can Kim get to the park?",
          "hint": "She should go … and take …",
          "answer": "Kim should go straight and take the second right; the park is at the end"
        }
      ],
      "dialogueGroup": "a1-09.model"
    },
    {
      "id": "s_personal",
      "kind": "activity",
      "title": "Ask about the town",
      "instruction": "Start at the hotel. Ask me how to reach the café, then ask me to repeat one direction",
      "minutes": 3,
