      "lines": [
        {
          "id": "A111-D81.1",
          "speaker": "Kim",
          "text": "Can I help you?",
          "audioText": "Can I help you?",
          "translation": "Posso ajudar?"
        },
        {
          "id": "A111-D81.2",
          "speaker": "Ana",
          "text": "Yes. I’d like this blue T-shirt in medium",
          "audioText": "Yes. I’d like this blue T-shirt in medium.",
          "translation": "Sim. Gostaria desta camiseta azul no tamanho médio"
        },
        {
          "id": "A111-D81.3",
          "speaker": "Kim",
          "text": "Sorry, we have blue in large, or green in medium",
          "audioText": "Sorry, we have blue in large, or green in medium.",
          "translation": "Desculpe, temos azul no grande ou verde no médio"
        },
        {
          "id": "A111-D81.4",
          "speaker": "Ana",
          "text": "Can I see the green one, please?",
          "audioText": "Can I see the green one, please?",
          "translation": "Posso ver a verde, por favor?"
        },
        {
          "id": "A111-D81.5",
          "speaker": "Kim",
          "text": "Here you are. It’s twelve dollars",
          "audioText": "Here you are. It’s twelve dollars.",
          "translation": "Aqui está. Custa doze dólares"
        },
        {
          "id": "A111-D81.6",
          "speaker": "Ana",
          "text": "That’s good. This one, please",
          "audioText": "That’s good. This one, please.",
          "translation": "Está bom. Quero esta, por favor"
        }
      ],
