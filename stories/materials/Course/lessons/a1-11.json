        {
          "id": "A111-D81.3",
          "speaker": "Kim",
          "text": "Sorry, we have blue in large, or green in medium",
          "audioText": "Sorry, we have blue in large, or green in medium.",
          "translation": "Desculpe, temos azul no grande ou verde no médio"
