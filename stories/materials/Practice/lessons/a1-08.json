    "phrases": [
      {
        "id": "a1-08.shadowing.01",
        "displayText": "Hello. My room key doesn’t work",
        "translation": "Olá. A chave do meu quarto não funciona",
        "speakerId": "evelyn-carter"
      },
      {
        "id": "a1-08.shadowing.02",
        "displayText": "I’m sorry. What’s your room number?",
        "translation": "Sinto muito. Qual é o número do seu quarto?",
        "speakerId": "owen-harris"
      },
      {
        "id": "a1-08.shadowing.03",
        "displayText": "Room twelve. Can you help me?",
        "translation": "Quarto doze. Pode me ajudar?",
        "speakerId": "evelyn-carter"
      },
      {
        "id": "a1-08.shadowing.04",
        "displayText": "Yes. Here’s a new key",
        "translation": "Sim. Aqui está uma nova chave",
        "speakerId": "owen-harris"
      },
      {
        "id": "a1-08.shadowing.05",
        "displayText": "Thank you. Can I have a towel, too?",
        "translation": "Obrigada. Posso ficar com uma toalha também?",
        "speakerId": "evelyn-carter"
      },
      {
        "id": "a1-08.shadowing.06",
        "displayText": "Of course. Here you are",
        "translation": "Claro. Aqui está",
        "speakerId": "owen-harris"
      }
