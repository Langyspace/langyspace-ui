  "shadowing": {
    "id": "course-practice-a2-06-shadowing",
    "kind": "shadowing",
    "phrases": [
      {
        "id": "a2-06.shadowing.01",
        "displayText": "Good afternoon. How can I help you?",
        "translation": "Boa tarde. Como posso ajudar?",
        "speakerId": "kim"
      },
      {
        "id": "a2-06.shadowing.02",
        "displayText": "My back hurts. I’d like to make an appointment",
        "translation": "Minhas costas doem. Gostaria de marcar uma consulta",
        "speakerId": "ana"
      },
      {
        "id": "a2-06.shadowing.03",
        "displayText": "When did it start?",
        "translation": "Quando começou?",
        "speakerId": "kim"
      },
      {
        "id": "a2-06.shadowing.04",
        "displayText": "Yesterday afternoon. Is there an appointment today?",
        "translation": "Ontem à tarde. Tem uma consulta hoje?",
        "speakerId": "ana"
      },
      {
        "id": "a2-06.shadowing.05",
        "displayText": "There’s one at three at the Green Clinic",
        "translation": "Tem uma às três na Green Clinic",
        "speakerId": "kim"
      },
      {
        "id": "a2-06.shadowing.06",
        "displayText": "Could you repeat the time, please?",
        "translation": "Pode repetir o horário, por favor?",
        "speakerId": "ana"
      },
      {
        "id": "a2-06.shadowing.07",
        "displayText": "Three o’clock. We’ll send you the address",
        "translation": "Às três. Vamos enviar o endereço",
        "speakerId": "kim"
      },
      {
        "id": "a2-06.shadowing.08",
        "displayText": "Thank you. I’ll check the message",
        "translation": "Obrigada. Vou conferir a mensagem",
        "speakerId": "ana"
      }
    ],
