  "shadowing": {
    "id": "course-practice-a2-08-shadowing",
    "kind": "shadowing",
    "phrases": [
      {
        "id": "a2-08.shadowing.01",
        "displayText": "Have you ever been to Lisbon?",
        "translation": "Você já esteve em Lisboa?",
        "speakerId": "ruby-bennett"
      },
      {
        "id": "a2-08.shadowing.02",
        "displayText": "Yes, I’ve been twice. Have you?",
        "translation": "Sim, já fui duas vezes. E você?",
        "speakerId": "noah-ellis"
      },
      {
        "id": "a2-08.shadowing.03",
        "displayText": "No, never. What did you do there?",
        "translation": "Não, nunca. O que você fez lá?",
        "speakerId": "ruby-bennett"
      },
      {
        "id": "a2-08.shadowing.04",
        "displayText": "I took a tram and visited the castle",
        "translation": "Peguei um bonde e visitei o castelo",
        "speakerId": "noah-ellis"
      },
      {
        "id": "a2-08.shadowing.05",
        "displayText": "Did you try a pastel de nata?",
        "translation": "Você já experimentou um pastel de nata?",
        "speakerId": "ruby-bennett"
      },
      {
        "id": "a2-08.shadowing.06",
        "displayText": "Of course. I had one every morning",
        "translation": "Claro. Eu tomava um todas as manhãs",
        "speakerId": "noah-ellis"
      },
      {
        "id": "a2-08.shadowing.07",
        "displayText": "That sounds lovely. I’m going there next month",
        "translation": "Parece ótimo. Vou para lá no mês que vem",
        "speakerId": "ruby-bennett"
      },
      {
        "id": "a2-08.shadowing.08",
        "displayText": "You’ll love it. Try to watch the sunset by the river",
        "translation": "Você vai adorar. Tente assistir ao pôr do sol à beira do rio",
        "speakerId": "noah-ellis"
      }
    ],
