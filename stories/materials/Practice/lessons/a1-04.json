    "phrases": [
      {
        "id": "a1-04.shadowing.01",
        "displayText": "What time do you wake up?",
        "translation": "A que horas você acorda?",
        "speakerId": "priya-nair"
      },
      {
        "id": "a1-04.shadowing.02",
        "displayText": "I wake up at seven and have breakfast at half past seven",
        "translation": "Acordo às sete e tomo o café da manhã às sete e meia",
        "speakerId": "arjun-mehta"
      },
      {
        "id": "a1-04.shadowing.03",
        "displayText": "Do you work in the morning?",
        "translation": "Você trabalha de manhã?",
        "speakerId": "priya-nair"
      },
      {
        "id": "a1-04.shadowing.04",
        "displayText": "Yes. I work in the morning and study in the afternoon",
        "translation": "Sim. Eu trabalho de manhã e estudo à tarde",
        "speakerId": "arjun-mehta"
      },
      {
        "id": "a1-04.shadowing.05",
        "displayText": "Do you go to the gym in the evening?",
        "translation": "Você vai à academia à noite?",
        "speakerId": "priya-nair"
      },
      {
        "id": "a1-04.shadowing.06",
        "displayText": "Yes. Then I go home and go to bed at ten",
        "translation": "Sim. Depois vou para casa e vou para a cama às dez",
        "speakerId": "arjun-mehta"
      }
    ],
