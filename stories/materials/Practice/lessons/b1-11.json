  "shadowing": {
    "id": "course-practice-b1-11-shadowing",
    "kind": "shadowing",
    "phrases": [
      {
        "id": "b1-11.shadowing.01",
        "displayText": "Who’s the woman standing by the speakers?",
        "translation": "Quem é a mulher que está perto das caixas de som?",
        "speakerId": "zanele-dlamini"
      },
      {
        "id": "b1-11.shadowing.02",
        "displayText": "She’s the friend who organised the music",
        "translation": "Ela é a amiga que organizou a música",
        "speakerId": "theo-jacobs"
      },
      {
        "id": "b1-11.shadowing.03",
        "displayText": "And the man with the green jacket?",
        "translation": "E o homem com a jaqueta verde?",
        "speakerId": "zanele-dlamini"
      },
      {
        "id": "b1-11.shadowing.04",
        "displayText": "He’s the guest who brought that amazing cake",
        "translation": "Ele é o convidado que trouxe aquele bolo incrível",
        "speakerId": "theo-jacobs"
      },
      {
        "id": "b1-11.shadowing.05",
        "displayText": "Is this the café where the couple first met?",
        "translation": "Este é o café onde o casal se conheceu?",
        "speakerId": "zanele-dlamini"
      },
      {
        "id": "b1-11.shadowing.06",
        "displayText": "Yes. They wanted a place that was special to them",
        "translation": "Sim. Eles queriam um lugar que fosse especial para eles",
        "speakerId": "theo-jacobs"
      },
      {
        "id": "b1-11.shadowing.07",
        "displayText": "What a lovely idea. Shall we go and say hello?",
        "translation": "Que ideia encantadora! Vamos lá cumprimentá-lo?",
        "speakerId": "zanele-dlamini"
      },
      {
        "id": "b1-11.shadowing.08",
        "displayText": "Let’s do that. I’d like to thank them for inviting us",
        "translation": "Vamos fazer isso. Gostaria de agradecer pelo convite",
        "speakerId": "theo-jacobs"
      }
    ],
