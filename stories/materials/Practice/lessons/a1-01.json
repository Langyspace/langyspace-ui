        "speakerId": "ana"
      },
      {
        "id": "a1-01.shadowing.03",
        "displayText": "Nice to meet you too. How are you?",
        "translation": "O prazer é meu. Como você está?",
        "speakerId": "kim"
      },
      {
        "id": "a1-01.shadowing.04",
        "displayText": "I’m good, thanks. I’m hungry! And you?",
        "translation": "Estou bem, obrigada. Estou com fome! E você?",
        "speakerId": "ana"
      },
      {
        "id": "a1-01.shadowing.05",
        "displayText": "I’m tired, but I’m happy. Welcome, Ana!",
        "translation": "Estou cansada, mas estou feliz. Bem-vinda, Ana!",
        "speakerId": "kim"
      },
      {
        "id": "a1-01.shadowing.06",
        "displayText": "Thank you! It’s nice to be here",
        "translation": "Obrigada! É bom estar aqui",
