        "speakerId": "ana"
      },
      {
        "id": "a1-06.shadowing.03",
        "displayText": "Hi, Thor! Do you have a cat too?",
        "translation": "Olá, Thor! Você também tem um gato?",
        "speakerId": "kim"
      },
      {
        "id": "a1-06.shadowing.04",
        "displayText": "Yes, I do. Her name is Mia. Mia! Where’s Mia?",
        "translation": "Sim, eu sei. O nome dela é Mia. Mia! Onde está a Mia?",
        "speakerId": "ana"
      },
      {
        "id": "a1-06.shadowing.05",
        "displayText": "Is she on the sofa?",
        "translation": "Ela está no sofá?",
        "speakerId": "kim"
      },
      {
        "id": "a1-06.shadowing.06",
        "displayText": "No, she isn’t. Look! She’s under the bed",
        "translation": "Não, ela não está. Olha! Ela está debaixo da cama",
        "speakerId": "ana"
      }
