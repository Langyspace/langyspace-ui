      },
      {
        "id": "a1-07.shadowing.03",
        "displayText": "And how long are you staying?",
        "translation": "E por quanto tempo?",
        "speakerId": "kim"
      },
      {
        "id": "a1-07.shadowing.04",
        "displayText": "For three days. Where is gate six?",
        "translation": "Por três dias. Onde fica o portão seis?",
        "speakerId": "ana"
      },
      {
        "id": "a1-07.shadowing.05",
        "displayText": "It’s on the left, next to the café",
        "translation": "Fica à esquerda, ao lado do café",
        "speakerId": "kim"
      },
      {
        "id": "a1-07.shadowing.06",
        "displayText": "Thank you. Can you say that again, please?",
