  "shadowing": {
    "id": "course-practice-c1-07-shadowing",
    "kind": "shadowing",
    "phrases": [
      {
        "id": "c1-07.shadowing.01",
        "displayText": "Having talked to the team, what would you tell someone who missed the meeting?",
        "translation": "Depois de conversar com a equipe, o que diria a alguém que perdeu a reunião?",
        "speakerId": "kim"
      },
      {
        "id": "c1-07.shadowing.02",
        "displayText": "The key point is that the event is being postponed, because the current quote exceeds the budget",
        "translation": "O principal é que o evento será adiado porque o orçamento atual excede o limite",
        "speakerId": "ana"
      },
      {
        "id": "c1-07.shadowing.03",
        "displayText": "Would you start with every number from the discussion?",
        "translation": "Você começaria com todos os números da discussão?",
        "speakerId": "kim"
      },
      {
        "id": "c1-07.shadowing.04",
        "displayText": "Not for everyone. The funding decision-maker needs the cost comparison; the rota organiser needs the date",
        "translation": "Não para todos. Quem decide a verba precisa da comparação de custos; quem organiza a escala precisa da data",
        "speakerId": "ana"
      },
      {
        "id": "c1-07.shadowing.05",
        "displayText": "But the new date hasn’t been confirmed yet",
        "translation": "Mas a nova data ainda não foi confirmada",
        "speakerId": "kim"
      },
      {
        "id": "c1-07.shadowing.06",
        "displayText": "Exactly. Given that constraint, I’d mark it as pending rather than ask people to rearrange everything",
        "translation": "Exatamente. Dada essa restrição, eu a marcaria como pendente em vez de pedir que reorganizem tudo",
        "speakerId": "ana"
      },
      {
        "id": "c1-07.shadowing.07",
        "displayText": "What can you leave out without changing the meaning?",
        "translation": "O que pode deixar de fora sem mudar o sentido?",
        "speakerId": "kim"
      },
      {
        "id": "c1-07.shadowing.08",
        "displayText": "The colour discussion and the sequence of suggestions. Neither changes the decision now",
        "translation": "A discussão de cores e a sequência de sugestões. Nenhuma muda a decisão agora",
        "speakerId": "ana"
      },
      {
        "id": "c1-07.shadowing.09",
        "displayText": "What action does the funding person need to take?",
        "translation": "Que ação a pessoa responsável pela verba precisa tomar?",
        "speakerId": "kim"
      },
      {
        "id": "c1-07.shadowing.10",
        "displayText": "Review the lower quote once the supplier’s date is confirmed",
        "translation": "Analisar o orçamento menor depois que a data do fornecedor for confirmada",
        "speakerId": "ana"
      },
      {
        "id": "c1-07.shadowing.11",
        "displayText": "And the rota organiser?",
        "translation": "E quem organiza a escala?",
        "speakerId": "kim"
      },
      {
        "id": "c1-07.shadowing.12",
        "displayText": "Wait for that confirmation, then check availability. Same facts, a different first question",
        "translation": "Esperar a confirmação e depois conferir a disponibilidade. Mesmos fatos, outra pergunta inicial",
        "speakerId": "ana"
      }
    ],
