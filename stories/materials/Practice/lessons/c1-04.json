  "voice": {
    "prompt": "Send me a voice note: negotiate a boundary that recognises both people’s needs",
    "duration": "90–120 seconds",
    "starters": ["Would you mind…?", "I’d rather you…", "I wish you wouldn’t…"],
    "closing": "Finish with one question for your teacher"
  },
  "homeworkCopy": {
    "title": "Colocando limites",
    "first": "Estudar as expressões para conversar sobre limites nos flashcards",
    "shadowing": "Ouvir e repetir as frases para negociar limites com respeito",
    "voice": "Mandar um áudio em inglês para a teacher explicando um limite pessoal e propondo uma combinação que respeite as necessidades das duas pessoas. Termine com uma pergunta"
  }
}
