  "shadowing": {
    "id": "course-practice-c1-04-shadowing",
    "kind": "shadowing",
    "phrases": [
      {
        "id": "c1-04.shadowing.01",
        "displayText": "Could we bring up the late calls before it becomes a recurring argument?",
        "translation": "Podemos conversar sobre as ligações tarde antes de isso virar uma discussão recorrente?",
        "speakerId": "kim"
      },
      {
        "id": "c1-04.shadowing.02",
        "displayText": "Yes. I’ve been finding it difficult to concentrate when calls carry through the shared room",
        "translation": "Sim. Tenho achado difícil me concentrar quando o som das chamadas passa pela sala compartilhada",
        "speakerId": "ana"
      },
      {
        "id": "c1-04.shadowing.03",
        "displayText": "I understand. I’m calling family in another time zone, so an earlier slot is difficult",
        "translation": "Entendo. Ligo para a família em outro fuso, então um horário mais cedo é difícil",
        "speakerId": "kim"
      },
      {
        "id": "c1-04.shadowing.04",
        "displayText": "Would you mind using the smaller room and headphones after nine?",
        "translation": "Você se importaria de usar o quarto menor e fones depois das nove?",
        "speakerId": "ana"
      },
      {
        "id": "c1-04.shadowing.05",
        "displayText": "I can do that, but I wouldn’t want to promise there will never be an urgent call",
        "translation": "Posso fazer isso, mas não gostaria de prometer que nunca haverá uma ligação urgente",
        "speakerId": "kim"
      },
      {
        "id": "c1-04.shadowing.06",
        "displayText": "That’s reasonable. I’d rather you let me know when there’s an exception than leave me guessing",
        "translation": "É razoável. Eu preferiria que me avisasse quando houvesse uma exceção em vez de me deixar adivinhar",
        "speakerId": "ana"
      },
      {
        "id": "c1-04.shadowing.07",
        "displayText": "Could we agree a regular quiet period, with a brief message if something unusual happens?",
        "translation": "Podemos combinar um período de silêncio, com uma mensagem breve se algo incomum acontecer?",
        "speakerId": "kim"
      },
      {
        "id": "c1-04.shadowing.08",
        "displayText": "Yes. The main issue for me is predictable concentration time, not controlling who you speak to",
        "translation": "Sim. O principal para mim é ter um horário previsível de concentração, não controlar com quem você fala",
        "speakerId": "ana"
      },
      {
        "id": "c1-04.shadowing.09",
        "displayText": "Then perhaps we can protect that time and still make the family call possible",
        "translation": "Então talvez possamos proteger esse horário e manter a ligação com a família",
        "speakerId": "kim"
      },
      {
        "id": "c1-04.shadowing.10",
        "displayText": "What period would be workable for you?",
        "translation": "Qual período seria viável para você?",
        "speakerId": "ana"
      },
      {
        "id": "c1-04.shadowing.11",
        "displayText": "I’ll check the family’s availability before committing to a precise end time",
        "translation": "Vou conferir a disponibilidade da família antes de me comprometer com um horário exato",
        "speakerId": "kim"
      },
      {
        "id": "c1-04.shadowing.12",
        "displayText": "Thanks. Let’s confirm the arrangement rather than assume a polite response means full agreement",
        "translation": "Obrigada. Vamos confirmar o acordo em vez de presumir que uma resposta educada significa concordância total",
        "speakerId": "ana"
      }
    ],
