      {
        "id": "a1-10.shadowing.01",
        "displayText": "Hello! What would you like?",
        "translation": "Olá! O que você gostaria de pedir?",
        "speakerId": "kim"
      },
      {
        "id": "a1-10.shadowing.02",
        "displayText": "I’d like some tea and a piece of cake, please",
        "translation": "Eu gostaria de chá e uma fatia de bolo, por favor",
        "speakerId": "ana"
      },
      {
        "id": "a1-10.shadowing.03",
        "displayText": "Of course. Would you like milk in your tea?",
        "translation": "Claro. Você quer leite no chá?",
        "speakerId": "kim"
      },
      {
        "id": "a1-10.shadowing.04",
        "displayText": "No milk, thank you. How much is it?",
        "translation": "Sem leite, obrigada. Quanto fica?",
        "speakerId": "ana"
      },
      {
        "id": "a1-10.shadowing.05",
        "displayText": "It’s six dollars. You can pay here",
        "translation": "Fica seis dólares. Pode pagar aqui",
        "speakerId": "kim"
      },
      {
        "id": "a1-10.shadowing.06",
        "displayText": "Here you are. Thank you!",
        "translation": "Aqui está. Obrigada!",
        "speakerId": "ana"
      }
    ],
