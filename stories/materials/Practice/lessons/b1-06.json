  "shadowing": {
    "id": "course-practice-b1-06-shadowing",
    "kind": "shadowing",
    "phrases": [
      {
        "id": "b1-06.shadowing.01",
        "displayText": "If you took the new job, what would change most?",
        "translation": "Se aceitasse o novo emprego, o que mudaria mais?",
        "speakerId": "kim"
      },
      {
        "id": "b1-06.shadowing.02",
        "displayText": "I’d have more flexibility, but a longer commute",
        "translation": "Eu teria mais flexibilidade, mas um trajeto maior",
        "speakerId": "ana"
      },
      {
        "id": "b1-06.shadowing.03",
        "displayText": "Would the longer journey be a problem every day?",
        "translation": "O trajeto maior seria um problema todos os dias?",
        "speakerId": "kim"
      },
      {
        "id": "b1-06.shadowing.04",
        "displayText": "Only on three days. I could work from home twice a week",
        "translation": "Só em três dias. Eu poderia trabalhar de casa duas vezes por semana",
        "speakerId": "ana"
      },
      {
        "id": "b1-06.shadowing.05",
        "displayText": "What would matter more to you: the journey or choosing your hours?",
        "translation": "O que importaria mais: o trajeto ou escolher seus horários?",
        "speakerId": "kim"
      },
      {
        "id": "b1-06.shadowing.06",
        "displayText": "I’m not sure yet. I’d like time for a course in the afternoon",
        "translation": "Ainda não sei. Gostaria de ter tempo para um curso à tarde",
        "speakerId": "ana"
      },
      {
        "id": "b1-06.shadowing.07",
        "displayText": "Then I’d ask whether the flexible hours really include afternoons",
        "translation": "Então eu perguntaria se o horário flexível realmente inclui as tardes",
        "speakerId": "kim"
      },
      {
        "id": "b1-06.shadowing.08",
        "displayText": "Good idea. If they didn’t, the offer would be much less useful",
        "translation": "Boa ideia. Se não incluísse, a proposta seria bem menos útil",
        "speakerId": "ana"
      }
    ],
