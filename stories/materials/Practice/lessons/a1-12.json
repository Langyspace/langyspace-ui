      {
        "id": "a1-12.shadowing.01",
        "displayText": "It’s sunny today. Let’s go to the park",
        "translation": "Hoje está um dia ensolarado. Vamos ao parque",
        "speakerId": "niamh-murphy"
      },
      {
        "id": "a1-12.shadowing.02",
        "displayText": "Good idea. Can we take the train?",
        "translation": "Boa ideia. Podemos ir de trem?",
        "speakerId": "cian-walsh"
      },
      {
        "id": "a1-12.shadowing.03",
        "displayText": "Yes. Two tickets are six euros",
        "translation": "Sim. Dois bilhetes custam seis euros",
        "speakerId": "niamh-murphy"
      },
      {
        "id": "a1-12.shadowing.04",
        "displayText": "Great. Do you have water?",
        "translation": "Ótimo. Você tem água?",
        "speakerId": "cian-walsh"
      },
      {
        "id": "a1-12.shadowing.05",
        "displayText": "Yes. I have water and two sandwiches",
        "translation": "Sim. Tenho água e dois sanduíches",
        "speakerId": "niamh-murphy"
      },
      {
        "id": "a1-12.shadowing.06",
        "displayText": "Perfect. Let’s go",
        "translation": "Perfeito. Vamos lá",
        "speakerId": "cian-walsh"
      }
    ],
