  },
  "homeworkCopy": {
    "title": "Adaptação a um lugar novo",
    "first": "Estudar as expressões de adaptação nos flashcards",
    "shadowing": "Ouvir e repetir as frases sobre se acostumar com algo",
    "voice": "Mandar um áudio em inglês para a teacher contando o que já parece normal para você em um lugar novo e ao que ainda está se adaptando. Termine com uma pergunta"
  }
