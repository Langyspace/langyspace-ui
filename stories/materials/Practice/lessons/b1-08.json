  "shadowing": {
    "id": "course-practice-b1-08-shadowing",
    "kind": "shadowing",
    "phrases": [
      {
        "id": "b1-08.shadowing.01",
        "displayText": "How are you finding your first winter here?",
        "translation": "Como está sendo seu primeiro inverno aqui?",
        "speakerId": "ruby-bennett"
      },
      {
        "id": "b1-08.shadowing.02",
        "displayText": "I’m still getting used to the cold",
        "translation": "Ainda estou me acostumando com o frio",
        "speakerId": "noah-ellis"
      },
      {
        "id": "b1-08.shadowing.03",
        "displayText": "I used to complain about hot summers. Now I miss them",
        "translation": "Antes eu reclamava dos verões quentes. Agora sinto falta deles",
        "speakerId": "ruby-bennett"
      },
      {
        "id": "b1-08.shadowing.04",
        "displayText": "Same here. I’m not used to wearing so many layers",
        "translation": "Eu também. Não estou acostumada a usar tantas camadas de roupa",
        "speakerId": "noah-ellis"
      },
      {
        "id": "b1-08.shadowing.05",
        "displayText": "Have you changed your morning routine?",
        "translation": "Você mudou sua rotina matinal?",
        "speakerId": "ruby-bennett"
      },
      {
        "id": "b1-08.shadowing.06",
        "displayText": "Yes. I leave earlier because I’m getting used to the commute",
        "translation": "Sim. Saio mais cedo porque estou me acostumando com o trajeto",
        "speakerId": "noah-ellis"
      },
      {
        "id": "b1-08.shadowing.07",
        "displayText": "It took me a while, but I’m used to it now",
        "translation": "Demorei um pouco, mas agora já me acostumei",
        "speakerId": "ruby-bennett"
      },
      {
        "id": "b1-08.shadowing.08",
        "displayText": "That’s good to hear. I’m sure it’ll get easier",
        "translation": "Que bom ouvir isso. Tenho certeza de que ficará mais fácil",
        "speakerId": "noah-ellis"
      }
    ],
