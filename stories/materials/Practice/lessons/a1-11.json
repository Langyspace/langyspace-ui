      },
      {
        "id": "a1-11.shadowing.03",
        "displayText": "Sorry, we have blue in large, or green in medium",
        "translation": "Desculpe, temos azul no grande ou verde no médio",
        "speakerId": "kim"
      },
      {
        "id": "a1-11.shadowing.04",
        "displayText": "Can I see the green one, please?",
        "translation": "Posso ver a verde, por favor?",
        "speakerId": "ana"
      },
      {
        "id": "a1-11.shadowing.05",
        "displayText": "Here you are. It’s twelve dollars",
        "translation": "Aqui está. Custa doze dólares",
        "speakerId": "kim"
      },
      {
        "id": "a1-11.shadowing.06",
