  "shadowing": {
    "id": "course-practice-b2-01-shadowing",
    "kind": "shadowing",
    "phrases": [
      {
        "id": "b2-01.shadowing.01",
        "displayText": "So, how was New York?",
        "translation": "E aí, como foi Nova York?",
        "speakerId": "kim"
      },
      {
        "id": "b2-01.shadowing.02",
        "displayText": "Pretty good, but on the second day, my phone died at four in the afternoon",
        "translation": "Bem bom, mas no segundo dia o meu celular descarregou às quatro da tarde",
        "speakerId": "ana"
      },
      {
        "id": "b2-01.shadowing.03",
        "displayText": "Oh no! Why?",
        "translation": "Ah, não! Por quê?",
        "speakerId": "kim"
      },
      {
        "id": "b2-01.shadowing.04",
        "displayText": "I’d been using it as a map all day, and I didn’t notice how low the battery was. And I’d left my charger at the hotel",
        "translation": "Eu vinha usando o celular como mapa o dia todo, e não reparei na bateria. E tinha deixado o carregador no hotel",
        "speakerId": "ana"
      },
      {
        "id": "b2-01.shadowing.05",
        "displayText": "Why didn’t you go back to the hotel?",
        "translation": "Por que você não voltou para o hotel?",
        "speakerId": "kim"
      },
      {
        "id": "b2-01.shadowing.06",
        "displayText": "I tried, but I got lost. And the team dinner was at seven. The address was in a message from Raj!",
        "translation": "Eu tentei, mas me perdi. E o jantar da equipe era às sete. O endereço estava numa mensagem do Raj!",
        "speakerId": "ana"
      },
      {
        "id": "b2-01.shadowing.07",
        "displayText": "So what did you do?",
        "translation": "E aí, o que você fez?",
        "speakerId": "kim"
      },
      {
        "id": "b2-01.shadowing.08",
        "displayText": "I asked a doorman for help, and he told me about a café. But there were no free outlets",
        "translation": "Pedi ajuda a um porteiro, e ele me falou de um café. Mas não tinha nenhuma tomada livre",
        "speakerId": "ana"
      },
      {
        "id": "b2-01.shadowing.09",
        "displayText": "Oh no. And then?",
        "translation": "Ah, não. E depois?",
        "speakerId": "kim"
      },
      {
        "id": "b2-01.shadowing.10",
        "displayText": "I’d been waiting there alone for twenty minutes when a woman lent me her power bank. Luckily, I had my cable",
        "translation": "Eu estava esperando lá sozinha havia vinte minutos quando uma moça me emprestou a bateria portátil dela. Por sorte, eu estava com o meu cabo",
        "speakerId": "ana"
      },
      {
        "id": "b2-01.shadowing.11",
        "displayText": "So did you make it to the dinner?",
        "translation": "E você chegou ao jantar, afinal?",
        "speakerId": "kim"
      },
      {
        "id": "b2-01.shadowing.12",
        "displayText": "Eventually, yes. I caught a taxi and got there at eight. By then, they’d been waiting for an hour!",
        "translation": "No fim, sim. Peguei um táxi e cheguei às oito. Àquela altura, eles já estavam esperando havia uma hora!",
        "speakerId": "ana"
      }
    ],
