  "shadowing": {
    "id": "course-practice-a2-05-shadowing",
    "kind": "shadowing",
    "phrases": [
      {
        "id": "a2-05.shadowing.01",
        "displayText": "Those boxes look heavy. Do you need a hand?",
        "translation": "Essas caixas parecem pesadas. Precisa de ajuda?",
        "speakerId": "kim"
      },
      {
        "id": "a2-05.shadowing.02",
        "displayText": "Yes, please. I can’t carry this one and open the door",
        "translation": "Sim, por favor. Não consigo carregar esta e abrir a porta",
        "speakerId": "ana"
      },
      {
        "id": "a2-05.shadowing.03",
        "displayText": "I’ll open the door. Then I’ll carry the smaller box",
        "translation": "Vou abrir a porta. Depois carrego a caixa menor",
        "speakerId": "kim"
      },
      {
        "id": "a2-05.shadowing.04",
        "displayText": "Thank you! I’m going to put everything in the living room",
        "translation": "Obrigada! Vou colocar tudo na sala",
        "speakerId": "ana"
      },
      {
        "id": "a2-05.shadowing.05",
        "displayText": "Are you going to paint the walls today?",
        "translation": "Você vai pintar as paredes hoje?",
        "speakerId": "kim"
      },
      {
        "id": "a2-05.shadowing.06",
        "displayText": "No, that’s the plan for tomorrow. Today I just want to unpack",
        "translation": "Não, esse é o plano para amanhã. Hoje só quero desfazer as malas",
        "speakerId": "ana"
      },
      {
        "id": "a2-05.shadowing.07",
        "displayText": "All right. I’ll move this chair so we have more space",
        "translation": "Tudo bem. Vou mover esta cadeira para termos mais espaço",
        "speakerId": "kim"
      },
      {
        "id": "a2-05.shadowing.08",
        "displayText": "That would be great. We can have coffee when we finish",
        "translation": "Seria ótimo. Podemos tomar café quando terminarmos",
        "speakerId": "ana"
      }
    ],
