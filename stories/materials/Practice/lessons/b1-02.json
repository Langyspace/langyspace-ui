  "shadowing": {
    "id": "course-practice-b1-02-shadowing",
    "kind": "shadowing",
    "phrases": [
      {
        "id": "b1-02.shadowing.01",
        "displayText": "This street looks completely different",
        "translation": "Esta rua parece completamente diferente",
        "speakerId": "evelyn-carter"
      },
      {
        "id": "b1-02.shadowing.02",
        "displayText": "I know. There used to be a cinema on that corner",
        "translation": "Eu sei. Costumava haver um cinema naquela esquina",
        "speakerId": "owen-harris"
      },
      {
        "id": "b1-02.shadowing.03",
        "displayText": "Did you use to go there after school?",
        "translation": "Você costumava ir lá depois da escola?",
        "speakerId": "evelyn-carter"
      },
      {
        "id": "b1-02.shadowing.04",
        "displayText": "Yes. We used to meet outside the ticket office every Friday",
        "translation": "Sim. Costumávamos nos encontrar em frente à bilheteria todas as sextas-feiras",
        "speakerId": "owen-harris"
      },
      {
        "id": "b1-02.shadowing.05",
        "displayText": "Now there’s an apartment block. What happened to the playground?",
        "translation": "Agora existe um prédio de apartamentos. O que aconteceu com o parquinho?",
        "speakerId": "evelyn-carter"
      },
      {
        "id": "b1-02.shadowing.06",
        "displayText": "It moved to the park. Children didn’t use to have much space there",
        "translation": "Mudou-se para o parque. As crianças não costumavam ter muito espaço lá",
        "speakerId": "owen-harris"
      },
      {
        "id": "b1-02.shadowing.07",
        "displayText": "The new square is lovely, but I miss the little shops",
        "translation": "A nova praça é linda, mas sinto falta das lojinhas",
        "speakerId": "evelyn-carter"
      },
      {
        "id": "b1-02.shadowing.08",
        "displayText": "Me too. There used to be a corner shop next to the cinema",
        "translation": "Eu também. Costumava haver uma mercearia perto do cinema",
        "speakerId": "owen-harris"
      }
    ],
