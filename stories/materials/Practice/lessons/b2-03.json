  "shadowing": {
    "id": "course-practice-b2-03-shadowing",
    "kind": "shadowing",
    "phrases": [
      {
        "id": "b2-03.shadowing.01",
        "displayText": "Do you ever wonder what life would be like if you’d stayed?",
        "translation": "Você já se perguntou como seria a vida se tivesse ficado?",
        "speakerId": "evelyn-carter"
      },
      {
        "id": "b2-03.shadowing.02",
        "displayText": "Sometimes. If I hadn’t moved to Toronto, I’d probably still be doing the same job",
        "translation": "Às vezes. Se eu não tivesse me mudado para Toronto, provavelmente ainda estaria fazendo o mesmo trabalho",
        "speakerId": "owen-harris"
      },
      {
        "id": "b2-03.shadowing.03",
        "displayText": "Would that have been a bad thing?",
        "translation": "Isso teria sido algo ruim?",
        "speakerId": "evelyn-carter"
      },
      {
        "id": "b2-03.shadowing.04",
        "displayText": "Not necessarily, but I wouldn’t know how much I enjoy working abroad",
        "translation": "Não necessariamente, mas não sei dizer o quanto eu gostaria de trabalhar no exterior",
        "speakerId": "owen-harris"
      },
      {
        "id": "b2-03.shadowing.05",
        "displayText": "So moving was a turning point?",
        "translation": "Então a mudança foi um ponto de virada?",
        "speakerId": "evelyn-carter"
      },
      {
        "id": "b2-03.shadowing.06",
        "displayText": "Definitely. If I hadn’t taken that chance, I wouldn’t feel this confident now",
        "translation": "Com certeza. Se eu não tivesse arriscado, não me sentiria tão confiante agora",
        "speakerId": "owen-harris"
      },
      {
        "id": "b2-03.shadowing.07",
        "displayText": "Was it easy from the start?",
        "translation": "Foi fácil desde o início?",
        "speakerId": "evelyn-carter"
      },
      {
        "id": "b2-03.shadowing.08",
        "displayText": "Not at all. I missed home and almost gave up",
        "translation": "De jeito nenhum. Eu sentia falta de casa e quase desisti",
        "speakerId": "owen-harris"
      },
      {
        "id": "b2-03.shadowing.09",
        "displayText": "What made you stay?",
        "translation": "O que te fez ficar?",
        "speakerId": "evelyn-carter"
      },
      {
        "id": "b2-03.shadowing.10",
        "displayText": "I got an opportunity to work with a really supportive team",
        "translation": "Tive a oportunidade de trabalhar com uma equipe que me apoiou muito",
        "speakerId": "owen-harris"
      },
      {
        "id": "b2-03.shadowing.11",
        "displayText": "It sounds as though the difficult part led to something good",
        "translation": "Parece que a parte difícil levou a algo bom",
        "speakerId": "evelyn-carter"
      },
      {
        "id": "b2-03.shadowing.12",
        "displayText": "It did. I can see that now, even if I couldn’t see it at the time",
        "translation": "Sim, aconteceu. Consigo ver isso agora, mesmo que não conseguisse ver na época",
        "speakerId": "owen-harris"
      }
    ],
