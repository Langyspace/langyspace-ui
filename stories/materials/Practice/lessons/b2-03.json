  "voice": {
    "prompt": "Send me a voice note: connect a past decision to present consequences without treating a hypothesis as fact",
    "duration": "90–120 seconds",
    "starters": [
      "If I hadn’t…, I wouldn’t be…",
      "I could have…",
      "We know that…"
    ],
    "closing": "Finish with one question for your teacher"
  },
  "homeworkCopy": {
    "title": "Uma escolha que mudou tudo",
    "first": "Estudar as expressões de escolhas e consequências nos flashcards",
    "shadowing": "Ouvir e repetir as frases sobre escolhas do passado e consequências atuais",
    "voice": "Mandar um áudio em inglês para a teacher explicando como uma escolha passada afetou sua vida hoje e imaginando como as coisas poderiam ser diferentes. Termine com uma pergunta"
  }
