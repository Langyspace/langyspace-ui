  "shadowing": {
    "id": "course-practice-a2-11-shadowing",
    "kind": "shadowing",
    "phrases": [
      {
        "id": "a2-11.shadowing.01",
        "displayText": "Shall we go on a hike on Sunday?",
        "translation": "Vamos fazer uma caminhada no domingo?",
        "speakerId": "kim"
      },
      {
        "id": "a2-11.shadowing.02",
        "displayText": "I’d like that. What does the forecast say?",
        "translation": "Eu gostaria. O que diz a previsão?",
        "speakerId": "ana"
      },
      {
        "id": "a2-11.shadowing.03",
        "displayText": "It might rain. If it rains, we’ll go to the museum instead",
        "translation": "Pode chover. Se chover, vamos ao museu",
        "speakerId": "kim"
      },
      {
        "id": "a2-11.shadowing.04",
        "displayText": "Good plan. What time is the bus?",
        "translation": "Bom plano. Que horas é o ônibus?",
        "speakerId": "ana"
      },
      {
        "id": "a2-11.shadowing.05",
        "displayText": "At nine. If we miss it, we can take the next one at nine thirty",
        "translation": "Às nove. Se perdermos, podemos pegar o próximo às nove e meia",
        "speakerId": "kim"
      },
      {
        "id": "a2-11.shadowing.06",
        "displayText": "All right. I’ll bring a raincoat. What about lunch?",
        "translation": "Tudo bem. Vou levar uma capa de chuva. E o almoço?",
        "speakerId": "ana"
      },
      {
        "id": "a2-11.shadowing.07",
        "displayText": "If we go to the museum, we’ll eat at the café inside",
        "translation": "Se formos ao museu, vamos comer no café lá dentro",
        "speakerId": "kim"
      },
      {
        "id": "a2-11.shadowing.08",
        "displayText": "Great. Let’s check the weather again before we leave",
        "translation": "Ótimo. Vamos conferir o tempo de novo antes de sair",
        "speakerId": "ana"
      }
    ],
