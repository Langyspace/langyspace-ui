  "shadowing": {
    "id": "course-practice-a2-02-shadowing",
    "kind": "shadowing",
    "phrases": [
      {
        "id": "a2-02.shadowing.01",
        "displayText": "How was your weekend? Did you go anywhere?",
        "translation": "Como foi seu fim de semana? Você foi a algum lugar?",
        "speakerId": "kim"
      },
      {
        "id": "a2-02.shadowing.02",
        "displayText": "Yes! I went to a market on Saturday and had coffee with a friend",
        "translation": "Sim! Fui a uma feira no sábado e tomei café com uma amiga",
        "speakerId": "ana"
      },
      {
        "id": "a2-02.shadowing.03",
        "displayText": "That sounds nice. Did you buy anything?",
        "translation": "Parece legal. Você comprou alguma coisa?",
        "speakerId": "kim"
      },
      {
        "id": "a2-02.shadowing.04",
        "displayText": "Just some fruit. Then we took photos by the river",
        "translation": "Só algumas frutas. Depois tiramos fotos perto do rio",
        "speakerId": "ana"
      },
      {
        "id": "a2-02.shadowing.05",
        "displayText": "And what did you do on Sunday?",
        "translation": "E o que você fez no domingo?",
        "speakerId": "kim"
      },
      {
        "id": "a2-02.shadowing.06",
        "displayText": "I stayed at home. I was tired, so I watched a film",
        "translation": "Fiquei em casa. Estava cansada, então assisti a um filme",
        "speakerId": "ana"
      },
      {
        "id": "a2-02.shadowing.07",
        "displayText": "Was it good? I’m looking for something to watch",
        "translation": "Foi bom? Estou procurando algo para assistir",
        "speakerId": "kim"
      },
      {
        "id": "a2-02.shadowing.08",
        "displayText": "It was really funny! What about you? How was your weekend?",
        "translation": "Foi muito engraçado! E você? Como foi seu fim de semana?",
        "speakerId": "ana"
      }
    ],
