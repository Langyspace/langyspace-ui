  "homeworkCopy": {
    "title": "Intenções e compromissos",
    "first": "Estudar os verbos para relatar falas e intenções nos flashcards",
    "shadowing": "Ouvir e repetir as frases para contar o que alguém aceitou ou recusou",
    "voice": "Mandar um áudio em inglês para a teacher relatando o que outras pessoas disseram ou prometeram, sem transformar uma intenção em uma garantia. Termine com uma pergunta"
  }
