  "shadowing": {
    "id": "course-practice-b2-07-shadowing",
    "kind": "shadowing",
    "phrases": [
      {
        "id": "b2-07.shadowing.01",
        "displayText": "How did the dinner planning go? Did everyone agree?",
        "translation": "Como foi o planejamento do jantar? Todos concordaram?",
        "speakerId": "kim"
      },
      {
        "id": "b2-07.shadowing.02",
        "displayText": "Not on everything. One person suggested having dinner on Saturday",
        "translation": "Não em tudo. Uma pessoa sugeriu jantar no sábado",
        "speakerId": "ana"
      },
      {
        "id": "b2-07.shadowing.03",
        "displayText": "And someone promised to book the table?",
        "translation": "E alguém prometeu reservar a mesa?",
        "speakerId": "kim"
      },
      {
        "id": "b2-07.shadowing.04",
        "displayText": "Yes, the host promised to book after checking the group’s availability",
        "translation": "Sim, quem vai receber prometeu reservar depois de conferir a disponibilidade",
        "speakerId": "ana"
      },
      {
        "id": "b2-07.shadowing.05",
        "displayText": "I heard that everyone agreed to pay in advance",
        "translation": "Ouvi dizer que todos concordaram em pagar adiantado",
        "speakerId": "kim"
      },
      {
        "id": "b2-07.shadowing.06",
        "displayText": "That’s not accurate. One guest refused to pay before seeing the cancellation conditions",
        "translation": "Isso não está correto. Uma pessoa se recusou a pagar antes de ver as condições de cancelamento",
        "speakerId": "ana"
      },
      {
        "id": "b2-07.shadowing.07",
        "displayText": "So suggesting dinner wasn’t the same as committing to the deposit",
        "translation": "Então sugerir o jantar não foi o mesmo que se comprometer com o depósito",
        "speakerId": "kim"
      },
      {
        "id": "b2-07.shadowing.08",
        "displayText": "Exactly. The person who suggested it also said the date was open to discussion",
        "translation": "Exatamente. Quem sugeriu também disse que a data estava aberta a discussão",
        "speakerId": "ana"
      },
      {
        "id": "b2-07.shadowing.09",
        "displayText": "Did anybody admit that the first summary was wrong?",
        "translation": "Alguém reconheceu que o primeiro resumo estava errado?",
        "speakerId": "kim"
      },
      {
        "id": "b2-07.shadowing.10",
        "displayText": "The host did. They offered to send a corrected summary to the group",
        "translation": "Sim, quem vai receber. Ofereceu-se para enviar um resumo corrigido ao grupo",
        "speakerId": "ana"
      },
      {
        "id": "b2-07.shadowing.11",
        "displayText": "That should help. We need to preserve what people actually intended",
        "translation": "Isso deve ajudar. Precisamos preservar o que as pessoas realmente quiseram dizer",
        "speakerId": "kim"
      },
      {
        "id": "b2-07.shadowing.12",
        "displayText": "Yes: a suggestion, a conditional promise and a refusal are three different things",
        "translation": "Sim: uma sugestão, uma promessa condicional e uma recusa são três coisas diferentes",
        "speakerId": "ana"
      }
    ],
