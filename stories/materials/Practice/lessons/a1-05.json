      {
        "id": "a1-05.shadowing.01",
        "displayText": "This market is great! Do you like mangoes?",
        "translation": "Este mercado é ótimo! Você gosta de mangas?",
        "speakerId": "kim"
      },
      {
        "id": "a1-05.shadowing.02",
        "displayText": "Yes, I do. I love mangoes. What about you?",
        "translation": "Sim, eu adoro. Adoro mangas. E você?",
        "speakerId": "ana"
      },
      {
        "id": "a1-05.shadowing.03",
        "displayText": "I like mangoes, but I don’t like watermelons",
        "translation": "Eu gosto de mangas, mas não gosto de melancias",
        "speakerId": "kim"
      },
      {
        "id": "a1-05.shadowing.04",
        "displayText": "My mother loves watermelons! Do you like carrots?",
        "translation": "Minha mãe adora melancias! Você gosta de cenouras?",
        "speakerId": "ana"
      },
      {
        "id": "a1-05.shadowing.05",
        "displayText": "Yes, I do. How much are they?",
        "translation": "Sim, tenho. Quanto custam?",
        "speakerId": "kim"
      },
      {
        "id": "a1-05.shadowing.06",
        "displayText": "They’re two dollars",
        "translation": "Custam dois dólares",
        "speakerId": "ana"
      }
    ],
