  "shadowing": {
    "id": "course-practice-tema-frontend-shadowing",
    "phrases": [
      {
        "id": "tema-frontend.shadowing.01",
        "speakerId": "kim",
        "displayText": "Ana, do you have a minute? There’s a bug before the launch. The “Buy now” button doesn’t show on mobile",
        "translation": "Ana, você tem um minuto? Tem um bug antes do lançamento. O botão “Buy now” não aparece no celular."
      },
      {
        "id": "tema-frontend.shadowing.02",
        "speakerId": "ana",
        "displayText": "Oh no! On which phones?",
        "translation": "Ah, não! Em quais celulares?"
      },
      {
        "id": "tema-frontend.shadowing.03",
        "speakerId": "kim",
        "displayText": "On small screens. When the pop-up opens, it covers the button. I’ve tested it on three phones, and it breaks on all of them",
        "translation": "Nas telas pequenas. Quando o pop-up abre, ele cobre o botão. Eu testei em três celulares, e quebra em todos."
      },
      {
        "id": "tema-frontend.shadowing.04",
        "speakerId": "ana",
        "displayText": "Hmm. What if we move the button above the pictures?",
        "translation": "Hum. E se a gente mudar o botão para cima das fotos?"
      },
      {
        "id": "tema-frontend.shadowing.05",
        "speakerId": "kim",
        "displayText": "Good idea, but the design will change. Could you check it today? The launch is on Friday",
        "translation": "Boa ideia, mas o design vai mudar. Você pode conferir hoje? O lançamento é na sexta."
      },
      {
        "id": "tema-frontend.shadowing.06",
        "speakerId": "ana",
        "displayText": "Sure. I’ll send you a new version this afternoon. Have you talked to Leo?",
        "translation": "Claro. Eu te mando uma versão nova hoje à tarde. Você já falou com o Leo?"
      },
      {
        "id": "tema-frontend.shadowing.07",
        "speakerId": "kim",
        "displayText": "Not yet. I’ve written to him, but he hasn’t answered yet. He’s in a meeting",
        "translation": "Ainda não. Eu escrevi para ele, mas ele ainda não respondeu. Ele está numa reunião."
      },
      {
        "id": "tema-frontend.shadowing.08",
        "speakerId": "ana",
        "displayText": "OK. And what about the screen reader? Last week, it didn’t read the button",
        "translation": "Tá. E o leitor de tela? Semana passada, ele não lia o botão."
      },
      {
        "id": "tema-frontend.shadowing.09",
        "speakerId": "kim",
        "displayText": "I’ve already fixed that. Now it reads “Buy now”. I tested it yesterday with my eyes closed!",
        "translation": "Isso eu já consertei. Agora ele lê “Buy now”. Eu testei ontem de olhos fechados!"
      },
      {
        "id": "tema-frontend.shadowing.10",
        "speakerId": "ana",
        "displayText": "Ha! Perfect. Let’s fix the mobile version, and then we can deploy",
        "translation": "Ha! Perfeito. Vamos consertar a versão do celular, e aí a gente pode publicar."
      }
    ],
