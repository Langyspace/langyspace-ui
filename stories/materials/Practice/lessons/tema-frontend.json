  "voice": {
    "prompt": "Tell me about a website or app you have worked on. Explain one problem, what you have fixed and what you still need to do",
    "duration": "60–90 seconds",
    "starters": ["The problem is…", "I’ve already…", "I haven’t… yet"],
    "closing": "Finish by asking your teacher to check one thing"
  },
  "homeworkCopy": {
    "title": "Um projeto de tecnologia",
    "first": "Estudar o vocabulário de telas, sites e aplicativos nos flashcards",
    "shadowing": "Ouvir e repetir as frases para explicar problemas e atualizações de um projeto",
    "voice": "Mandar um áudio em inglês para a teacher apresentando um site ou aplicativo em que trabalhou. Explique um problema, o que já corrigiu e o que ainda precisa fazer. Peça para a teacher conferir um ponto"
  }
