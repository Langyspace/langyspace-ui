  "shadowing": {
    "id": "course-practice-c1-05-shadowing",
    "kind": "shadowing",
    "phrases": [
      {
        "id": "c1-05.shadowing.01",
        "displayText": "I nearly cancelled the trip, to be honest",
        "translation": "Para ser sincera, quase cancelei a viagem",
        "speakerId": "niamh-murphy"
      },
      {
        "id": "c1-05.shadowing.02",
        "displayText": "Really? You seemed quite excited about it",
        "translation": "Sério? Você parecia bem animado com isso",
        "speakerId": "cian-walsh"
      },
      {
        "id": "c1-05.shadowing.03",
        "displayText": "I was, but the forecast looked terrible and the train had been delayed",
        "translation": "Eu estava, mas a previsão do tempo era péssima e o trem estava atrasado",
        "speakerId": "niamh-murphy"
      },
      {
        "id": "c1-05.shadowing.04",
        "displayText": "What changed your mind?",
        "translation": "O que te fez mudar de ideia?",
        "speakerId": "cian-walsh"
      },
      {
        "id": "c1-05.shadowing.05",
        "displayText": "A friend said we should go anyway. Little did I know how much I needed the break",
        "translation": "Um amigo disse que devíamos ir de qualquer maneira. Mal sabia eu o quanto precisava daquela pausa",
        "speakerId": "niamh-murphy"
      },
      {
        "id": "c1-05.shadowing.06",
        "displayText": "So it turned out well?",
        "translation": "Então, no fim deu tudo certo?",
        "speakerId": "cian-walsh"
      },
      {
        "id": "c1-05.shadowing.07",
        "displayText": "Better than I expected. The rain stopped just as we arrived",
        "translation": "Melhor do que eu esperava. A chuva parou assim que chegamos",
        "speakerId": "niamh-murphy"
      },
      {
        "id": "c1-05.shadowing.08",
        "displayText": "That was lucky",
        "translation": "Que sorte!",
        "speakerId": "cian-walsh"
      },
      {
        "id": "c1-05.shadowing.09",
        "displayText": "It was. No sooner had we checked in than the sun came out",
        "translation": "Sim, foi. Mal tínhamos feito o check-in e o sol já apareceu",
        "speakerId": "niamh-murphy"
      },
      {
        "id": "c1-05.shadowing.10",
        "displayText": "And that was the turning point?",
        "translation": "E esse foi o ponto de virada?",
        "speakerId": "cian-walsh"
      },
      {
        "id": "c1-05.shadowing.11",
        "displayText": "Absolutely. Looking back, the last thing I expected was to come home feeling so rested",
        "translation": "Com certeza. Olhando para trás, a última coisa que eu esperava era voltar para casa me sentindo tão descansada",
        "speakerId": "niamh-murphy"
      },
      {
        "id": "c1-05.shadowing.12",
        "displayText": "Sometimes the trip you almost skip is the one you remember",
        "translation": "Às vezes, a viagem que você quase perde é aquela que você lembra",
        "speakerId": "cian-walsh"
      }
    ],
