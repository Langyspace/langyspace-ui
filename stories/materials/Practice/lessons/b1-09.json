  "shadowing": {
    "id": "course-practice-b1-09-shadowing",
    "kind": "shadowing",
    "phrases": [
      {
        "id": "b1-09.shadowing.01",
        "displayText": "What happened? You look worried",
        "translation": "O que aconteceu? Você parece preocupada",
        "speakerId": "kim"
      },
      {
        "id": "b1-09.shadowing.02",
        "displayText": "My bike was taken from the rack near the station. I last saw it at six",
        "translation": "Minha bicicleta foi levada do bicicletário perto da estação. Eu a vi pela última vez às seis",
        "speakerId": "ana"
      },
      {
        "id": "b1-09.shadowing.03",
        "displayText": "Have you reported it?",
        "translation": "Você já registrou a ocorrência?",
        "speakerId": "kim"
      },
      {
        "id": "b1-09.shadowing.04",
        "displayText": "Yes. They asked for a description and the serial number",
        "translation": "Sim. Pediram uma descrição e o número de série",
        "speakerId": "ana"
      },
      {
        "id": "b1-09.shadowing.05",
        "displayText": "How can they identify it?",
        "translation": "Como podem identificá-la?",
        "speakerId": "kim"
      },
      {
        "id": "b1-09.shadowing.06",
        "displayText": "It’s blue, with a black basket and a yellow sticker on the frame",
        "translation": "É azul, com cesta preta e adesivo amarelo no quadro",
        "speakerId": "ana"
      },
      {
        "id": "b1-09.shadowing.07",
        "displayText": "Has anything been found yet?",
        "translation": "Já encontraram alguma coisa?",
        "speakerId": "kim"
      },
      {
        "id": "b1-09.shadowing.08",
        "displayText": "Not yet. A similar bike was seen nearby, but nobody has checked the number",
        "translation": "Ainda não. Viram uma bicicleta parecida por perto, mas ninguém conferiu o número",
        "speakerId": "ana"
      }
    ],
