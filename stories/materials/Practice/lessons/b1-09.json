  "voice": {
    "prompt": "Send me a voice note: report a missing bike precisely without claiming it has been found",
    "duration": "60–90 seconds",
    "starters": [
      "The… was taken…",
      "A similar… has been…",
      "It hasn’t been… yet"
    ],
    "closing": "Finish with one question for your teacher"
  },
  "homeworkCopy": {
    "title": "Uma bicicleta desaparecida",
    "first": "Estudar as palavras para descrever uma bicicleta e seus acessórios",
    "shadowing": "Ouvir e repetir as frases para relatar um desaparecimento",
    "voice": "Mandar um áudio em inglês para a teacher relatando o desaparecimento de uma bicicleta com detalhes. Explique o que sabe sem dizer que ela foi encontrada se isso não aconteceu. Termine com uma pergunta"
  }
